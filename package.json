{
  "name": "labslot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "demo": "node scripts/demo.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/index.js",
    "start:hosted": "node scripts/start-hosted.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:concurrency": "node scripts/concurrency.mjs",
    "test:production": "node scripts/smoke-production.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/luxon3": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@fullcalendar/vue3": "^6.1.19",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-vue-next": "^0.468.0",
    "luxon": "^3.7.2",
    "pg": "^8.16.3",
    "vue": "^3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "embedded-postgres": "18.4.0-beta.17",
    "supertest": "^7.1.4",
    "vite": "^6.4.4"
  }
}
