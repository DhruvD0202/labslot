# Copy to .env for your own PostgreSQL server. npm run demo creates local settings automatically.
DATABASE_URL=postgresql://labslot:change-me@127.0.0.1:5432/labslot
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Required only when seeding demo accounts. Use at least 12 characters.
DEMO_PASSWORD=LabSlot-demo-2026!
# Build-time demo buttons; keep false for an app with real accounts.
VITE_DEMO_MODE=false
# Hosted startup only: opt in to the fictional, shared demo accounts.
SEED_DEMO=false
# 0 for direct local access. Verify the proxy path before setting this on a host.
TRUST_PROXY_HOPS=0
