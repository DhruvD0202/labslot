# Copy to .env for your own PostgreSQL server. npm run demo creates local settings automatically.
DATABASE_URL=postgresql://labslot:change-me@127.0.0.1:5432/labslot
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Required only when seeding demo accounts. Use at least 12 characters.
DEMO_PASSWORD=LabSlot-demo-2026!
